desktop.ini

# Config local de auth AD — secretos, nunca al repo (ver .env.example)
.env

# ZIPs de release
*.zip

# Python bytecode
__pycache__/
*.pyc

# Pickles (datos intermedios)
*.pkl

# Excels legacy (formato _7d) — solo se admiten Analisis_*_WNN.xlsx y Dataset_*_WNN.xlsx
Analisis_*_7d*.xlsx
Analisis_Rates_NoDispo_*_7d*.xlsx
Analisis_Checkrates_*_7d*.xlsx

# Datasets crudos — NUNCA van al repo, ni en la raíz ni dentro de
# checkrates/rates-nodispo/. Viven solo en Price_stage/_datasets_raw/ (local,
# sin git). Comentario anterior decía lo contrario y causó que 20 datasets
# (201MB) terminaran commiteados — ver W28-security-review.
/Dataset_*.xlsx
/data_set_*.xlsx
/Week*.xlsx
/Week-*.xlsx
# Datasets de input (no van al repo — archivos grandes, cambian cada semana)
Dataset_*.xlsx
detalleHoteles_*.xlsx
inventory/Dataset_*.xlsx
inventory/detalleHoteles_*.xlsx
# dataHoteles_contratos.xlsx (input crudo de calc_inv.py) — mismo trato que
# Dataset_*.xlsx, no matchea ese patrón por el nombre. 2 variantes de mayúscula
# terminaron commiteadas (68.7MB c/u) — ver W28-security-review.
dataHoteles_contratos.xlsx
datahoteles_contratos.xlsx

# Archivos de lock temporales de Excel — nunca deberían commitearse
~$*.xlsx

# Pickles generados por el pipeline
*.pkl

# Parciales HTML intermedios
part*.html

# Archivos temporales Python
__pycache__/
*.pyc

# Baseline local de check_html (regenera por build, no va al repo)
.html_budget.json

Price_W*.zip
pipeline_*.log
pipeline_*_summary.json
