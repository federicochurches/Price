# ── Configuración de autenticación AD (Active Directory) ──────────────────────
# Copiá este archivo a `.env` (mismo directorio) y completá los valores reales.
#   El `.env` está gitignored: los secretos NO van al repo.
#   ad_auth_service.py lo carga solo; las env vars reales del sistema tienen
#   prioridad sobre lo que esté acá.
#
#   cp .env.example .env      (o copiar a mano en Windows)

# Servidor LDAP/AD. Si se deja vacío, se usa AD_DOMAIN como servidor.
AD_SERVER=
# Dominio corporativo (ej. pricetravel.com.mx). Se usa para armar user@dominio
# y, si falta AD_BASE_DN, para derivar DC=pricetravel,DC=com,DC=mx.
AD_DOMAIN=
# Puerto LDAP. 636 = LDAPS (SSL), 389 = LDAP plano.
AD_PORT=636
# SSL: true para LDAPS (puerto 636), false para LDAP plano (puerto 389).
AD_USE_SSL=true
# Base DN. Si se deja vacío se deriva de AD_DOMAIN.
AD_BASE_DN=
# Plantilla opcional del DN de usuario (soporta {username} y {domain}).
# Vacío o "{username}" => se usa user@dominio automáticamente.
AD_USER_DN_TEMPLATE=
# Dominio de respaldo si AD_DOMAIN no está seteado.
AD_DOMAIN_FALLBACK=

# ── Fallback de prueba (OFF por defecto) ──────────────────────────────────────
# El atajo de login de prueba SOLO se activa si PRICE_ALLOW_TEST_LOGIN es 1/true/yes.
# Dejalo comentado/vacío en producción para forzar autenticación contra AD real.
# PRICE_ALLOW_TEST_LOGIN=1
# PRICE_TEST_USER=
# PRICE_TEST_PASSWORD=
