# WEEK_CONFIG.yml · Week 21 · Configuración Centralizada del Pipeline
# 
# Uso:
#   python3 run_pipeline.py WEEK_CONFIG.yml
#
# Este archivo centraliza TODA la configuración semanal.
# No es necesario editar scripts individuales — solo actualizar este YAML.

# ── METADATOS SEMANA ACTUAL ────────────────────────────────────────────────
week: 21
vol_num: "21"
periodo: "19–25 may 2026"
mes_año: "Mayo 2026"
fecha_pub: "Lunes 26 mayo 2026"

# ── METADATOS SEMANA ANTERIOR (para WoW) ──────────────────────────────────
week_prev: 20
vol_num_prev: "20"
periodo_prev: "12–18 may 2026"

# ── METADATOS SEMANA ANTERIOR-2 (para deltas históricos) ─────────────────
week_prev2: 19
vol_num_prev2: "19"
periodo_prev2: "5–11 may 2026"

# ── PATHS (no cambiar a menos que la estructura del proyecto cambie) ─────
paths:
  project: "/mnt/project"
  outputs: "/mnt/user-data/outputs"
  uploads: "/mnt/user-data/uploads"

# ── DATASETS (verificados antes de ejecutar pipeline) ───────────────────
# Ruta relativa a /mnt/project o /mnt/user-data/uploads
# El script busca automáticamente en ambas ubicaciones
datasets:
  ratesno_dispo_w21: "Dataset_RatesNoDispo_W21.xlsx"
  ratesno_dispo_w20: "Dataset_RatesNoDispo_W20.xlsx"
  checkrates_w21: "Dataset_CheckRates_W21.xlsx"
  checkrates_w20: "Dataset_CheckRates_W20.xlsx"

# ── PIPELINE STEPS (en orden de ejecución) ─────────────────────────────
# No cambiar a menos que agreguemos nuevos pasos
pipeline:
  - calc_rnd
  - calc_cr
  - render_rnd
  - render_cr
  - assemble
  - excel
  - mail
  - build_package

# ── OPCIONES (debug/logging) ──────────────────────────────────────────
verbose: true
abort_on_non_critical_fail: false  # Si true: abortar si falla Excel o Mail
